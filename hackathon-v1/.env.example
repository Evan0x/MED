# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chat / translation / speech (server-only)
GEMINI_API_KEY=
GOOGLE_TRANSLATE_KEY=
GOOGLE_TTS_KEY=

# Public site URL (QR codes, share links)
VITE_PUBLIC_URL=http://localhost:5173

# OpenStreetMap stack (optional — public defaults are used if unset)
# Do not treat public Overpass/Photon endpoints as unlimited production infrastructure.
OVERPASS_URL=https://overpass-api.de/api/interpreter
PHOTON_URL=https://photon.komoot.io
OSM_USER_AGENT=Avelamed/1.0 (https://avelamed.vercel.app; healthcare locator)

# MapLibre vector tiles (OpenFreeMap). Dark falls back to VITE_MAP_STYLE_URL, then OpenFreeMap Dark.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
